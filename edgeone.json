{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "caches": [
    {
      "source": "/",
      "cacheTtl": 300
    },
    {
      "source": "/assets/*",
      "cacheTtl": 31536000
    }
  ]
}
