        {
          "id": "pexels",
          "label": "Pexels",
          "kind": "external",
          "url": "https://www.pexels.com/",
          "searchTemplate": "https://www.pexels.com/search/{query}/"
        },
        {
          "id": "unsplash",
          "label": "Unsplash",
          "kind": "external",
          "url": "https://unsplash.com/",
          "searchTemplate": "https://unsplash.com/s/photos/{query}/"
        }
      ]
